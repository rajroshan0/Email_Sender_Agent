# For running on your own computer (testing). Copy to .env values into your terminal, never commit real values.
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=change-me-to-another-long-random-string
APP_PASSWORD=choose-a-team-password
